# Firebase — copia este archivo a .env.local y rellena con los valores
# de tu proyecto Firebase (Configuración del proyecto → Tu app web).
# Todos estos valores son PÚBLICOS (la seguridad está en las reglas de Firestore).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
