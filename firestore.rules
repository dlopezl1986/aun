rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Shared spaces. A space groups records shared with other people:
    //   cal_<ownerUid>_<calendarId>  one calendar and its events
    //   fam_<ownerUid>               the family: members, lists, shopping
    // Its id embeds the owner, so nobody can create a space in someone
    // else's name. roles: { uid: 'view' | 'edit' | 'admin' }.
    //
    // A family is a group: its owner and 'admin' members are adults who
    // manage it (invite, change roles); 'edit' members can add and change
    // family data; 'view' members only see it. A calendar can be shared with
    // the whole family (`family` = the family space id, `familyRole` = what
    // members can do): access then follows family membership, so people who
    // join see it at once and people who leave stop seeing it.
    // ---------------------------------------------------------------------
    function ownSpace(s) {
      return s == 'fam_' + uid() || s.matches('cal_' + uid() + '_.+');
    }
    function spaceDoc(s) {
      return get(/databases/$(db)/documents/spaces/$(s)).data;
    }
    function hasSpace(s) {
      return exists(/databases/$(db)/documents/spaces/$(s));
    }
    // My role in a family space document ('admin' for its owner).
    function famRoleIn(fd, u) {
      return fd.ownerId == u ? 'admin' : fd.roles.get(u, 'none');
    }
    function inFamily(f) {
      return f != null && hasSpace(f) && uid() in spaceDoc(f).memberIds;
    }
    function familyWriter(f) {
      return f != null && hasSpace(f) && famRoleIn(spaceDoc(f), uid()) in ['admin', 'edit'];
    }
    function canRead(s) {
      return s != null && (ownSpace(s) || (hasSpace(s) && (
        uid() in spaceDoc(s).memberIds || inFamily(spaceDoc(s).get('family', null))
      )));
    }
    function canWrite(s) {
      return s != null && (ownSpace(s) || (hasSpace(s) && (
        spaceDoc(s).roles.get(uid(), 'none') in ['edit', 'admin']
        || (spaceDoc(s).get('familyRole', null) == 'edit' && familyWriter(spaceDoc(s).get('family', null)))
      )));
    }

    // ---------------------------------------------------------------------
    // AUN user data. One document per row: <ownerUid>_<collection>_<id>.
    // Private rows have spaceId == null and only their owner sees them.
    // ---------------------------------------------------------------------
    // Shape every row must keep: the server stamps the change time (pulls rely on it,
    // so it cannot be faked to hide a change), and the payload matches the envelope.
    function wellFormed() {
      let r = request.resource.data;
      return r.serverUpdatedAt == request.time
        && r.updatedAt is string
        && r.data.get('id', null) == r.id
        && r.data.get('ownerId', null) == r.ownerId;
    }

    match /records/{docId} {
      allow read: if signedIn()
        && (resource.data.ownerId == uid() || canRead(resource.data.get('spaceId', null)));

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && docId == uid() + '_' + request.resource.data.collection + '_' + request.resource.data.id
        && wellFormed()
        && (request.resource.data.get('spaceId', null) == null || canWrite(request.resource.data.spaceId));

      // Owner, or an editor of the row's space. The owner, id and collection
      // never change; a row only moves to a space the writer can edit (only
      // its owner can make it private again).
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && request.resource.data.collection == resource.data.collection
        && wellFormed()
        // Last write wins on the server too: an older version (a device that was
        // offline) never overwrites a newer one; the client then takes the server's.
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && (resource.data.ownerId == uid() || canWrite(resource.data.get('spaceId', null)))
        && (
          request.resource.data.get('spaceId', null) == resource.data.get('spaceId', null)
          || (request.resource.data.get('spaceId', null) == null && resource.data.ownerId == uid())
          || canWrite(request.resource.data.get('spaceId', null))
        );

      // Deletions are tombstones (updates); hard deletes only by the owner.
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    // ---------------------------------------------------------------------
    // Spaces: the owner manages them; a person joins one only with a valid,
    // unexpired, single-use invitation that grants it (claimed in the same
    // batch), adding exactly themselves with exactly the granted role.
    // ---------------------------------------------------------------------
    function joining(spaceId) {
      let inv = getAfter(/databases/$(db)/documents/invites/$(request.resource.data.joinedWith)).data;
      let role = inv.grants.get(spaceId, null);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return role != null
        // The owner invites to any of their spaces; a family admin to the family.
        && (inv.ownerId == resource.data.ownerId
          || (spaceId.matches('fam_.+') && famRoleIn(resource.data, inv.ownerId) == 'admin'))
        && inv.usedBy == uid()
        && inv.expiresAt > request.time
        && !(uid() in resource.data.memberIds)
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && uid() in request.resource.data.memberIds
        && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid()])
        && request.resource.data.roles[uid()] == role
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()])
        && changed.hasOnly(['memberIds', 'roles', 'names', 'joinedWith', 'assignee', 'updatedAt'])
        && (!('assignee' in changed) || (inv.get('assign', null) == spaceId && request.resource.data.assignee == uid()));
    }

    // A member leaves (e.g. deleting their account): removes only themselves.
    function leaving() {
      let after = request.resource.data;
      return uid() in resource.data.memberIds
        && resource.data.ownerId != uid()
        && after.ownerId == resource.data.ownerId
        && after.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'names', 'assignee', 'updatedAt'])
        && after.memberIds.toSet() == resource.data.memberIds.toSet().difference([uid()].toSet())
        && after.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid()])
        && !(uid() in after.roles)
        && after.names.diff(resource.data.names).affectedKeys().hasOnly([uid()])
        && !(uid() in after.names)
        && (after.get('assignee', null) == resource.data.get('assignee', null)
          || (after.get('assignee', null) == null && resource.data.get('assignee', null) == uid()));
    }

    // A calendar is shared with a family only by someone in that family.
    function familyLinkOk() {
      let f = request.resource.data.get('family', null);
      return (f == null && request.resource.data.get('familyRole', null) == null)
        || (f.matches('fam_.+') && inFamily(f) && request.resource.data.get('familyRole', null) in ['view', 'edit']);
    }

    // A family admin (not the owner) manages people: roles, adding or
    // removing members — never the owner, the owner field or anything else.
    function managingFamily(spaceId) {
      let after = request.resource.data;
      return spaceId.matches('fam_.+')
        && resource.data.ownerId != uid()
        && famRoleIn(resource.data, uid()) == 'admin'
        && after.ownerId == resource.data.ownerId
        && resource.data.ownerId in after.memberIds
        && !(resource.data.ownerId in after.roles)
        && after.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'names', 'updatedAt']);
    }

    match /spaces/{spaceId} {
      // Own spaces can be read even before they exist (to create them); others by
      // their members, and calendars shared with a family by that family.
      allow read: if signedIn() && (
        ownSpace(spaceId) || uid() in resource.data.memberIds || inFamily(resource.data.get('family', null))
      );
      allow create: if signedIn()
        && ownSpace(spaceId)
        && request.resource.data.ownerId == uid()
        && uid() in request.resource.data.memberIds
        && familyLinkOk();
      allow update: if signedIn() && (
        (resource.data.ownerId == uid() && request.resource.data.ownerId == uid() && uid() in request.resource.data.memberIds
          && familyLinkOk())
        || joining(spaceId)
        || leaving()
        || managingFamily(spaceId)
      );
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    // ---------------------------------------------------------------------
    // Invitations: the link carries a random code (the document id). Anyone
    // signed in who has the code can read it and claim it once.
    // ---------------------------------------------------------------------
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerId == uid();
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.usedBy == null
        && code.size() >= 20;
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedByName', 'usedAt'])
        && request.resource.data.usedBy == uid()
        && resource.data.ownerId != uid();
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    // ---------------------------------------------------------------------
    // Notices outside the app (e-mail / Telegram). The notifier job uses the
    // Admin SDK (bypasses these rules); users only touch their own documents.
    // ---------------------------------------------------------------------
    function sameOrNull(field) {
      return request.resource.data.get(field, null) == null
        || (resource != null && request.resource.data.get(field, null) == resource.data.get(field, null));
    }

    match /notify/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      // Your own account e-mail only (no sending summaries to someone else), and
      // the Telegram chat is set only by the bot when you press Start: here it
      // can just stay as it is or be cleared.
      allow create, update: if signedIn() && uid() == userId
        && (request.resource.data.get('email', null) == null || request.resource.data.email == request.auth.token.email)
        && sameOrNull('telegramChatId')
        && sameOrNull('telegramName');
    }

    match /outbox/{id} {
      allow read, delete: if signedIn() && resource.data.uid == uid();
      allow create, update: if signedIn()
        && request.resource.data.uid == uid()
        && id.matches(uid() + '_.+');
    }

    match /digests/{id} {
      allow read, delete: if signedIn() && resource.data.uid == uid();
      allow create, update: if signedIn()
        && request.resource.data.uid == uid()
        && id.matches(uid() + '_.+');
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
