# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values reach the app bundle,
# so put ONLY public identifiers here — never secrets (client secrets, API keys…).

EXPO_PUBLIC_APP_ENV=development

# OAuth client IDs (public identifiers). Needed from Phase 3 (Drive) / Phase 7 (Mail) / Phase 9 (Auth).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=

# AUN backend (Phase 9) — Supabase. Leave empty to keep the local-only mode.
# The anon key is public by design (RLS protects the data). NEVER the service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Social sign-in enabled in Supabase Auth (comma separated): google,apple
EXPO_PUBLIC_AUTH_PROVIDERS=
EXPO_PUBLIC_API_BASE_URL=
